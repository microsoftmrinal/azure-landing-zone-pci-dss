# Populate with your values - DO NOT commit real values to version control
connectivity_subscription_id = "00000000-0000-0000-0000-000000000000"
management_subscription_id   = "00000000-0000-0000-0000-000000000000"
cde_subscription_id          = "00000000-0000-0000-0000-000000000000"

primary_location = "northeurope"
dr_location      = "westeurope"
environment      = "prod"
org_prefix       = "org"

hub_address_space_primary       = ["10.1.0.0/16"]
hub_address_space_dr            = ["10.2.0.0/16"]
spoke_cde_address_space_primary = ["10.10.0.0/16"]
spoke_cde_address_space_dr      = ["10.20.0.0/16"]

sql_admin_object_id  = "00000000-0000-0000-0000-000000000000"
sql_admin_login_name = "sg-sql-admins-cde"

hsm_admin_object_ids = ["00000000-0000-0000-0000-000000000000"]

# --- Phase rollout flags ---
# Phase 1 minimum: governance + hub(VPN GW) + Standard firewall + spoke + key platform + IIS VM.
deploy_vpn_gateway   = true
deploy_key_platform  = true
deploy_compute_vm    = true
deploy_data_platform = false # flip true later to add SQL + audit storage
deploy_front_door    = false # flip true later (needs deploy_compute_vm) to add Front Door + WAF

# --- Firewall ---
firewall_sku_tier = "Standard" # upgrade to "Premium" in place before go-live (enables IDPS/TLS)

# --- VPN Gateway ---
vpn_gateway_sku = "VpnGw2AZ"
# Leave these unset for a gateway-only deploy; set them to stand up the S2S tunnel
# to the remote/host-to-host device.
# on_prem_gateway_ip     = "203.0.113.10"
# on_prem_address_spaces = ["192.168.0.0/24"]
# vpn_shared_key         = "<from Key Vault>"

# --- IIS application (VM behind internal LB + Private Link Service) ---
app_port = 8082
# FQDN on the IIS certificate (must cover both regions); required when deploy_front_door = true.
# app_origin_hostname = "app.example.com"
# custom_domain_name  = "app.example.com"
# West Europe Private Link Service ID from the environments/dr outputs (adds the priority-2 origin).
# dr_private_link_service_id = "/subscriptions/<id>/resourceGroups/rg-cde-dr-weu/providers/Microsoft.Network/privateLinkServices/pls-org-cde-dr-weu"

# --- Client B: inbound over VPN (firewall + NSG allow TCP app_port from these prefixes) ---
# client_b_inbound_prefixes = ["192.168.10.0/24"]

# --- Client A: connections initiated by the custom app on the VM ---
# client_a_destination_prefixes = ["203.0.113.20/32"]
# client_a_destination_ports    = ["443"]
# Reserved IP added to the firewall. Client A must allow-list ALL firewall egress IPs (see outputs).
# client_a_egress_public_ip_id  = "/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Network/publicIPAddresses/pip-clientA-nat-egress"

# vm_admin_password is supplied securely at deploy time (scripts/Deploy-LandingZone.ps1 prompts for it
# and passes it as TF_VAR_vm_admin_password). Do not set it in this file: a value here overrides the prompt.

# Security contact for Defender for Cloud alerts.
security_contact_email = "security@example.com"

common_tags = {
  Environment        = "Production"
  PCIScope           = "CDE"
  DataClassification = "CardholderData"
  ManagedBy          = "Terraform"
  Workload           = "CDE-Workload"
}
